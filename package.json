{
  "name": "practice-site-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Layout, build and checks shared by small practice websites. Each site repo holds only its own content and settings.",
  "type": "module",
  "bin": {
    "sitekit": "dist/cli.js"
  },
  "files": [
    "dist",
    "themes",
    "rules.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
